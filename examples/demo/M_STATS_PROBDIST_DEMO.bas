Attribute VB_Name = "M_STATS_PROBDIST_DEMO"
'==============================================================================
' MODULE: M_STATS_PROBDIST_DEMO
'------------------------------------------------------------------------------
' PURPOSE
'   Answer the callbacks of the demo workbook's Probability Distributions
'   Ribbon tab, and show or hide the navigation bar of its sheets. The
'   RibbonX source is generated by tools/demobuild/build_demo.py from
'   examples/demo/sheets.json; the layout follows the K-SACCR workbook.
'
' PUBLIC SURFACE
'   RibbonOnLoad: keep the Ribbon object, so that the tab can be refreshed.
'   RibbonAction: run the command of a button. RibbonGoTo: activate the sheet
'   of a Go to entry, by CodeName. RibbonGetEnabled: whether a control is
'   available. RibbonToggle and RibbonGetPressed: the Navigation bar toggle.
'   RibbonSheet: the CodeName of the sheet a Go to entry opens.
'   NavigationBarShown, ShowNavigationBar and ToggleNavigationBar: whether
'   the bar is shown, and show or hide it on every sheet at once.
'   NavigationBarBeforeSave and NavigationBarAfterSave: show the bar for a
'   save and hide it again, so that the workbook is always saved with it.
'   RecalculateWorkbook: recalculate the sheets of this workbook only.
'
' DESIGN
'   The callbacks hold no numerical logic and call no library function.
'   Every routine works on ThisWorkbook alone, so another open workbook is
'   never touched. Application state that a routine changes (screen
'   updating) is put back before it returns, on success and on failure.
'
' DEPENDENCIES
'   The Microsoft Office object library (IRibbonUI, IRibbonControl), which
'   the built project references.
'==============================================================================

Option Explicit

'------------------------------------------------------------------------------
' MODULE CONSTANTS
'------------------------------------------------------------------------------
    'Title of every message box: the project name.
        Private Const MSG_TITLE         As String = "Probability Distributions"
    'The shape groups of the navigation bar, as the builder names them.
        Private Const NAV_GROUP_TOP     As String = "NavBarTop"    'Block in the frozen rows 1 to 3
        Private Const NAV_GROUP_REST    As String = "NavBar"       'Block below the frozen rows

'------------------------------------------------------------------------------
' MODULE STATE
'------------------------------------------------------------------------------
        Private mRibbon             As IRibbonUI    'The Ribbon, from RibbonOnLoad
        Private mBarHiddenForSave   As Boolean      'The bar was hidden when a save began
        Private mBeforeSaveCalls    As Long         'Observed before-save calls
        Private mAfterSaveCalls     As Long         'Observed after-save calls
        Private mSaveError          As String       'Last navigation save error
        Private mBeforeSaveShown    As Boolean      'Navigation just before disk save
        Private mAfterSaveShown     As Boolean      'Navigation before session restore

'------------------------------------------------------------------------------
' RIBBON CALLBACKS
'------------------------------------------------------------------------------

Public Sub RibbonOnLoad( _
    ByVal Ribbon As IRibbonUI)
'
'==============================================================================
'                                RibbonOnLoad
'------------------------------------------------------------------------------
' PURPOSE
'   Keep the Ribbon object Excel passes when it loads the tab, so that
'   RefreshRibbon can ask Excel to read the state of the controls again.
'==============================================================================
'
        Set mRibbon = Ribbon

End Sub


Public Sub RibbonAction( _
    ByVal Control As IRibbonControl)
'
'==============================================================================
'                                RibbonAction
'------------------------------------------------------------------------------
' PURPOSE
'   Run the command of a Ribbon button.
'
' ERROR POLICY
'   An unknown button is reported in a message box, and nothing changes.
'==============================================================================
'
        On Error GoTo Failed
        Select Case Control.Id
            Case "pdRecalculate"
                RecalculateWorkbook
            Case "pdResetInputs"
                MsgBox "This workbook has no editable example inputs yet.", vbInformation, MSG_TITLE
            Case Else
                MsgBox "The Ribbon command " & Control.Id & " does nothing.", vbExclamation, MSG_TITLE
        End Select
        Exit Sub

Failed:
        MsgBox "The Ribbon command could not be run: " & Err.Description, vbExclamation, MSG_TITLE

End Sub


Public Sub RibbonGoTo( _
    ByVal Control As IRibbonControl)
'
'==============================================================================
'                                 RibbonGoTo
'------------------------------------------------------------------------------
' PURPOSE
'   Activate the sheet of this workbook whose CodeName RibbonSheet maps to
'   a Go to entry, so that a renamed sheet tab cannot break the entry.
'
' ERROR POLICY
'   A sheet this workbook does not have is reported in a message box, and
'   nothing changes; another workbook is never touched.
'==============================================================================
'
    Dim Target      As String       'CodeName of the sheet
    Dim Sheet       As Worksheet    'A sheet of this workbook
    Dim Found       As Worksheet    'The sheet with that CodeName

        On Error GoTo Failed
        Target = RibbonSheet(Control.Id)
        If Len(Target) > 0 Then
            For Each Sheet In ThisWorkbook.Worksheets
                If StrComp(Sheet.CodeName, Target, vbTextCompare) = 0 Then
                    Set Found = Sheet
                    Exit For
                End If
            Next Sheet
        End If
        If Found Is Nothing Then
            MsgBox "This workbook has no sheet for the Ribbon entry " & Control.Id & ".", vbExclamation, MSG_TITLE
        Else
            ThisWorkbook.Activate
            Found.Activate
        End If
        Exit Sub

Failed:
        MsgBox "The sheet could not be opened: " & Err.Description, vbExclamation, MSG_TITLE

End Sub


Public Sub RibbonGetEnabled( _
    ByVal Control As IRibbonControl, _
    ByRef ReturnedVal As Variant)
'
'==============================================================================
'                              RibbonGetEnabled
'------------------------------------------------------------------------------
' PURPOSE
'   Whether a control is available. Reset inputs stays disabled until the
'   thematic sheets define editable inputs; every other control is enabled.
'
' ERROR POLICY
'   Never raises; a state that cannot be read gives True.
'==============================================================================
'
        On Error GoTo Failed
        ReturnedVal = (Control.Id <> "pdResetInputs")
        Exit Sub

Failed:
        ReturnedVal = True

End Sub


Public Sub RibbonToggle( _
    ByVal Control As IRibbonControl, _
    ByVal Pressed As Boolean)
'
'==============================================================================
'                                RibbonToggle
'------------------------------------------------------------------------------
' PURPOSE
'   Answer a toggle button: Navigation bar (pdNavigationBar) shows the
'   navigation bar of every sheet when pressed and hides it when released.
'
' ERROR POLICY
'   ShowNavigationBar reports its own failure. An unknown toggle is
'   reported in a message box, and nothing changes.
'==============================================================================
'
        On Error GoTo Failed
        Select Case Control.Id
            Case "pdNavigationBar"
                ShowNavigationBar Pressed
            Case Else
                MsgBox "The Ribbon toggle " & Control.Id & " changes nothing.", vbExclamation, MSG_TITLE
                RefreshRibbon
        End Select
        Exit Sub

Failed:
        MsgBox "The Ribbon toggle could not be used: " & Err.Description, vbExclamation, MSG_TITLE

End Sub


Public Sub RibbonGetPressed( _
    ByVal Control As IRibbonControl, _
    ByRef ReturnedVal As Variant)
'
'==============================================================================
'                              RibbonGetPressed
'------------------------------------------------------------------------------
' PURPOSE
'   Whether a toggle button is pressed: Navigation bar is pressed while the
'   navigation bar is shown, as the workbook holds it, so the state
'   survives a reset of the VBA state. It never writes.
'
' ERROR POLICY
'   Never raises; an unknown toggle, or a state that cannot be read, gives
'   True.
'==============================================================================
'
        On Error GoTo Failed
        Select Case Control.Id
            Case "pdNavigationBar"
                ReturnedVal = NavigationBarShown()
            Case Else
                ReturnedVal = True
        End Select
        Exit Sub

Failed:
        ReturnedVal = True

End Sub


Public Function RibbonSheet( _
    ByVal ControlId As String) _
    As String
'
'==============================================================================
'                                 RibbonSheet
'------------------------------------------------------------------------------
' PURPOSE
'   The CodeName of the sheet a Go to entry opens, as
'   examples/demo/sheets.json gives it; "" for any other control.
'   tests/test_demo_shell.py checks this map against the generated Ribbon.
'==============================================================================
'
        Select Case ControlId
            Case "pdGo"
                RibbonSheet = "shHome"
            Case "pdGoHome"
                RibbonSheet = "shHome"
            Case "pdGoExplorer"
                RibbonSheet = "shExplorer"
            Case "pdGoProbability"
                RibbonSheet = "shProbability"
            Case "pdGoParameters"
                RibbonSheet = "shParameters"
            Case "pdGoComparison"
                RibbonSheet = "shComparison"
            Case "pdGoTails"
                RibbonSheet = "shTails"
            Case "pdGoDiscrete"
                RibbonSheet = "shDiscrete"
            Case "pdGoRisk"
                RibbonSheet = "shRisk"
            Case "pdGoDiagnostics"
                RibbonSheet = "shDiagnostics"
            Case "pdGoReadme"
                RibbonSheet = "shReadme"
            Case Else
                RibbonSheet = vbNullString
        End Select

End Function


Public Sub RefreshRibbon()
'
'==============================================================================
'                                RefreshRibbon
'------------------------------------------------------------------------------
' PURPOSE
'   Ask Excel to read the state of the tab's controls again.
'
' ERROR POLICY
'   Never raises. After a reset of the VBA state the Ribbon object is lost
'   and the tab keeps the state it shows until the workbook is reopened.
'==============================================================================
'
        On Error Resume Next
        If Not mRibbon Is Nothing Then mRibbon.Invalidate
        On Error GoTo 0

End Sub


'------------------------------------------------------------------------------
' COMMANDS
'------------------------------------------------------------------------------

Public Sub RecalculateWorkbook()
'
'==============================================================================
'                             RecalculateWorkbook
'------------------------------------------------------------------------------
' PURPOSE
'   Recalculate every worksheet of this workbook, and no other workbook.
'
' ERROR POLICY
'   A failure is reported in a message box.
'==============================================================================
'
    Dim Sheet       As Worksheet    'Each worksheet

        On Error GoTo Failed
        For Each Sheet In ThisWorkbook.Worksheets
            Sheet.Calculate
        Next Sheet
        Exit Sub

Failed:
        MsgBox "Recalculate: " & Err.Description, vbExclamation, MSG_TITLE

End Sub


'------------------------------------------------------------------------------
' NAVIGATION BAR
'------------------------------------------------------------------------------

Public Function NavigationBarShown() As Boolean
'
'==============================================================================
'                             NavigationBarShown
'------------------------------------------------------------------------------
' PURPOSE
'   Whether the navigation bar is shown: column A of the first worksheet
'   is not hidden. The workbook holds the state, not a variable.
'
' ERROR POLICY
'   Never raises; a state that cannot be read gives True.
'==============================================================================
'
        On Error GoTo Failed
        NavigationBarShown = Not ThisWorkbook.Worksheets(1).Columns(1).Hidden
        Exit Function

Failed:
        NavigationBarShown = True

End Function


Public Sub ShowNavigationBar( _
    ByVal Shown As Boolean)
'
'==============================================================================
'                              ShowNavigationBar
'------------------------------------------------------------------------------
' PURPOSE
'   Show or hide the navigation bar of every sheet, for this session, and
'   refresh the tab so that the toggle shows the state the workbook holds.
'   The workbook is always saved with the bar shown
'   (NavigationBarBeforeSave).
'
' ERROR POLICY
'   A failure is reported in a message box, after the tab is refreshed.
'==============================================================================
'
        On Error GoTo Failed
        ApplyNavigationBar Shown
        RefreshRibbon
        Exit Sub

Failed:
        RefreshRibbon
        MsgBox "Navigation bar: " & Err.Description, vbExclamation, MSG_TITLE

End Sub


Public Sub ToggleNavigationBar()
'
'==============================================================================
'                             ToggleNavigationBar
'------------------------------------------------------------------------------
' PURPOSE
'   Show the navigation bar when it is hidden and hide it when it is shown,
'   from the Macros dialog or the Immediate window.
'==============================================================================
'
        ShowNavigationBar Not NavigationBarShown()

End Sub


Public Sub NavigationBarBeforeSave()
'
'==============================================================================
'                           NavigationBarBeforeSave
'------------------------------------------------------------------------------
' PURPOSE
'   Show the navigation bar before a save, when it is hidden, so that the
'   file is always saved with the bar shown; NavigationBarAfterSave hides
'   it again.
'
' ERROR POLICY
'   Never raises: a save must not fail because of the bar.
'==============================================================================
'
        mBeforeSaveCalls = mBeforeSaveCalls + 1
        mSaveError = vbNullString
        On Error GoTo Failed
        mBarHiddenForSave = Not NavigationBarShown()
        If mBarHiddenForSave Then ApplyNavigationBar True
        mBeforeSaveShown = NavigationBarShown()
        Exit Sub

Failed:
        mSaveError = CStr(Err.Number) & ": " & Err.Description

End Sub


Public Sub NavigationBarAfterSave()
'
'==============================================================================
'                           NavigationBarAfterSave
'------------------------------------------------------------------------------
' PURPOSE
'   Hide the navigation bar again after a save, when
'   NavigationBarBeforeSave showed it, and keep the workbook's Saved flag.
'
' ERROR POLICY
'   Never raises.
'==============================================================================
'
        mAfterSaveCalls = mAfterSaveCalls + 1
        mAfterSaveShown = NavigationBarShown()
        On Error GoTo Failed
        If mBarHiddenForSave Then
            mBarHiddenForSave = False
            ApplyNavigationBar False
        End If
        Exit Sub

Failed:
        mSaveError = CStr(Err.Number) & ": " & Err.Description

End Sub


Public Function NavigationBarSaveStatus() As String
'
' PURPOSE
'   Read the observed save-hook counts and last error for acceptance evidence.
'   No workbook or application state is changed.
'
        NavigationBarSaveStatus = "before=" & CStr(mBeforeSaveCalls) & _
                                  "; after=" & CStr(mAfterSaveCalls) & _
                                  "; beforeShown=" & CStr(mBeforeSaveShown) & _
                                  "; afterShown=" & CStr(mAfterSaveShown) & _
                                  "; error=" & mSaveError

End Function


Private Function ApplyNavigationBar( _
    ByVal Shown As Boolean) _
    As Long
'
'==============================================================================
'                             ApplyNavigationBar
'------------------------------------------------------------------------------
' PURPOSE
'   Show or hide column A and the shape groups NAV_GROUP_TOP and
'   NAV_GROUP_REST of every worksheet in one pass, with screen updating
'   off, so the layout changes at once. A protected sheet is protected
'   again for the user interface only, without a password, so that the
'   macro can change it; an unprotected sheet stays unprotected. The
'   workbook's Saved flag and screen updating are kept.
'
' RETURNS
'   The number of worksheets changed.
'
' ERROR POLICY
'   Re-raises the first error after screen updating and the Saved flag are
'   restored.
'==============================================================================
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Sheet               As Worksheet    'Each worksheet
    Dim Item                As Shape        'Each shape of a sheet
    Dim WasSaved            As Boolean      'The workbook's Saved flag before
    Dim SavedScreen         As Boolean      'Screen updating before
    Dim Changed             As Long         'Worksheets changed
    Dim ErrorNumber         As Long         'The first error's number
    Dim ErrorDescription    As String       'The first error's description

'------------------------------------------------------------------------------
' SHOW OR HIDE
'------------------------------------------------------------------------------
        WasSaved = ThisWorkbook.Saved
        SavedScreen = Application.ScreenUpdating
        On Error GoTo Failed
        Application.ScreenUpdating = False
        For Each Sheet In ThisWorkbook.Worksheets
            If Sheet.ProtectContents Then
                Sheet.Protect DrawingObjects:=True, Contents:=True, Scenarios:=True, UserInterfaceOnly:=True
            End If
            Sheet.Columns(1).Hidden = Not Shown
            For Each Item In Sheet.Shapes
                If Item.Name = NAV_GROUP_TOP Or Item.Name = NAV_GROUP_REST Then
                    Item.Visible = IIf(Shown, msoTrue, msoFalse)
                End If
            Next Item
            Changed = Changed + 1
        Next Sheet
        Application.ScreenUpdating = SavedScreen
        ThisWorkbook.Saved = WasSaved
        ApplyNavigationBar = Changed
        Exit Function

Failed:
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description
        Application.ScreenUpdating = SavedScreen
        ThisWorkbook.Saved = WasSaved
        Err.Raise ErrorNumber, "ApplyNavigationBar", ErrorDescription

End Function
