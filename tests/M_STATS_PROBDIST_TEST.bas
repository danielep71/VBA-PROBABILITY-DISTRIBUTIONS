    AssertIsError "F inverse above envelope (2e10)", _
        K_STATS_F_InverseCumulative(0.5, 20000000000#, 3#)
    AssertIsError "F sf df far beyond envelope", _
        K_STATS_F_Survival(1E+308, 1E+99, 1E-99)
