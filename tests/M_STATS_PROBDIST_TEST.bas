    R = CDbl(K_STATS_Gamma_Survival((2.10000000000000E+00 + (0.00000000000000E+00)), 1# + 2# ^ (-52), 1#))
    AssertTrue "B6 shape seam lower 2.1", (L <= V)
    AssertTrue "B6 shape seam upper 2.1", (V <= R)
